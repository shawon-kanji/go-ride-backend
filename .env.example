APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_ride
DB_SSLMODE=disable

JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=go-ride-backend
JWT_AUDIENCE=go-ride-clients
JWT_DRIVER_AUDIENCE=go-ride-drivers

# Local values below target the AIStor container started from
# go-ride-infra/local/docker-compose.yml (`make up` in this repo delegates
# there). In staging/production, leave STORAGE_ENDPOINT/STORAGE_ACCESS_KEY_ID/
# STORAGE_SECRET_ACCESS_KEY unset and STORAGE_USE_PATH_STYLE=false — the
# pod's IAM role supplies real AWS S3 credentials automatically (IRSA).
STORAGE_BUCKET=go-ride-driver-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_PRESIGN_EXPIRY_MINUTES=15

# Server-side key for Directions/Geocoding/Places (go-ride-dev-504212 project,
# "Go Ride Backend Server Key"). Restricted by API target only, not by app —
# never ship this key inside the mobile app bundles. Not yet consumed by any
# code; wired in once the places/routing endpoints (POLISHED-MVP.md B2/B5) land.
GOOGLE_MAPS_SERVER_API_KEY=your-server-side-google-maps-api-key
