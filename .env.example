APP_PORT=8080

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=go_ride
DB_SSLMODE=disable

JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRY_MINUTES=60
JWT_ISSUER=go-ride-backend
JWT_AUDIENCE=go-ride-clients
JWT_DRIVER_AUDIENCE=go-ride-drivers

# Local values below target the AIStor container in docker-compose.yml. In
# staging/production, leave STORAGE_ENDPOINT/STORAGE_ACCESS_KEY_ID/
# STORAGE_SECRET_ACCESS_KEY unset and STORAGE_USE_PATH_STYLE=false — the
# pod's IAM role supplies real AWS S3 credentials automatically (IRSA).
STORAGE_BUCKET=go-ride-driver-documents
STORAGE_REGION=us-east-1
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true
STORAGE_PRESIGN_EXPIRY_MINUTES=15

# AIStor requires a license file even for local/free-tier use (MinIO's OSS
# server was archived; AIStor is the maintained, S3-API-compatible
# replacement). Get a free-tier license at min.io/pricing, save it locally,
# and point this at it. Do not commit the license file.
AISTOR_LICENSE_PATH=./aistor.license
